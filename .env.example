PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart_manufacturing

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your-session-secret-change-this-in-production

# 2FA App Name (shown in authenticator apps)
TOTP_APP_NAME=SmartMfgPortal

# Unity WebGL build path (relative to public/)
UNITY_BUILD_PATH=/unity/index.html
